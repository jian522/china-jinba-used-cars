# jinbacars.com response headers (Cloudflare Pages)
# Cache-Control paths must not overlap: Pages combines headers from all matches.
# URLs are reused, so assets must not be marked immutable.

# Global security headers only; no global Cache-Control.
/*
  X-Content-Type-Options: nosniff

# HTML: browser 5 minutes / edge 1 hour.
/
  Cache-Control: public, max-age=300, s-maxage=3600

/index.html
  Cache-Control: public, max-age=300, s-maxage=3600

/en/*
  Cache-Control: public, max-age=300, s-maxage=3600

/zh/*
  Cache-Control: public, max-age=300, s-maxage=3600

/ru/*
  Cache-Control: public, max-age=300, s-maxage=3600

/ar/*
  Cache-Control: public, max-age=300, s-maxage=3600

# Static assets: browser 1 hour / edge 1 day.
/assets/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/js/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/images/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/uploads/cars/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/favicon.svg
  Cache-Control: public, max-age=3600, s-maxage=86400

# Site metadata and feed: browser 5 minutes / edge 1 hour.
/sitemap.xml
  Cache-Control: public, max-age=300, s-maxage=3600

/sitemap-images.xml
  Cache-Control: public, max-age=300, s-maxage=3600

/robots.txt
  Cache-Control: public, max-age=300, s-maxage=3600

/feed.xml
  Cache-Control: public, max-age=300, s-maxage=3600

/google12925231ec118e3f.html
  Cache-Control: public, max-age=300, s-maxage=3600

/6d9a7c2e4f8b41a39c5d7e0b2f6a8c14.txt
  Cache-Control: public, max-age=300, s-maxage=3600

/404.html
  Cache-Control: public, max-age=300, s-maxage=3600
